# ── Clean Air Companion – Environment Variables ──────────────────
# Copy this file to .env and fill in values as needed.

# Anthropic API key for AI-powered personalised summaries.
# Leave blank or unset to use the deterministic template fallback.
ANTHROPIC_API_KEY=

# Which Claude model to use for summaries (default: claude-haiku-5-5).
PLANNER_MODEL=claude-haiku-5-5

# Timeout in seconds for LLM requests (default: 15).
PLANNER_TIMEOUT_SECONDS=15
